# Opcional. Sin esta variable el sistema usa el parser y el redactor
# determinísticos y el prototipo funciona igual.
GEMINI_API_KEY=
LENALDI_WHATSAPP_NUMBER=

# Origen HTTPS del frontend publicado. Se pueden indicar varios orígenes
# separados por coma. Los orígenes http://localhost y http://127.0.0.1 se
# admiten automáticamente para desarrollo.
FRONTEND_ORIGIN=

# Variable pública usada únicamente al construir el frontend estático.
# En Vercel debe contener la URL HTTPS del backend de Render, sin barra final.
VITE_API_URL=

# Fuente principal del catálogo. VTEX consulta Carrefour Argentina y usa el
# JSON local automáticamente si la consulta falla.
ECOMMERCE_PROVIDER=vtex

# Integración demostrativa de solo lectura con las páginas públicas de Lenaldi.
# No requiere credenciales y conserva una copia en memoria durante 15 minutos.
# ECOMMERCE_PROVIDER=lenaldi
LENALDI_CACHE_TTL_SECONDS=900
